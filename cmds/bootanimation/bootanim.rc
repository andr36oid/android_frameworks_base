service bootanim /system/bin/bootanimation
    class core animation
    user graphics
    # andr36oid: input, log and SYSLOG for the boot log on screen (BootLogScreen.cpp),
    # cache for the boot progress markers on /cache (andr36oid-bootanim.rc)
    group graphics audio input log cache
    capabilities SYSLOG
    disabled
    oneshot
    ioprio rt 0
    task_profiles MaxPerformance
