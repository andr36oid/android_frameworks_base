<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Power menu stats strip along the top of the screen above the power menu, in the look
         of the performance overlay (PerfOverlay). ro.andr36oid.power_menu_stats offers it,
         persist.sys.power_menu_stats=0 hides it. -->
    <dimen name="global_actions_stats_padding_horizontal">8dp</dimen>
    <dimen name="global_actions_stats_padding_top">4dp</dimen>
    <dimen name="global_actions_stats_padding_bottom">6dp</dimen>
    <dimen name="global_actions_stats_cell_gap">12dp</dimen>
    <dimen name="global_actions_stats_graph_height">12dp</dimen>
    <dimen name="global_actions_stats_graph_gap">2dp</dimen>
    <!-- The overlay's text size -->
    <dimen name="global_actions_stats_text_size">11sp</dimen>
    <!-- The "ZRAM on" note under the RAM graph -->
    <dimen name="global_actions_stats_small_text_size">9sp</dimen>

    <!-- The overlay's colors (PerfOverlay res/values/colors.xml) -->
    <color name="global_actions_stats_background">#B3000000</color>
    <!-- labels, graphs and the RAM graph's apps layer follow the accent (orange until one is picked) -->
    <color name="global_actions_stats_label">@*android:color/accent_device_default_dark</color>
    <color name="global_actions_stats_value">#FFFFFF</color>
    <color name="global_actions_stats_good">#69F0AE</color>
    <color name="global_actions_stats_ok">#FFD740</color>
    <color name="global_actions_stats_bad">#FF5252</color>
    <!-- The RAM graph's layers: apps, the kernel, the rest of the used RAM, the cache -->
    <color name="global_actions_stats_ram_apps">@color/global_actions_stats_label</color>
    <color name="global_actions_stats_ram_kernel">#B388FF</color>
    <color name="global_actions_stats_ram_other">#B0BEC5</color>
    <color name="global_actions_stats_ram_cache">#69F0AE</color>

    <!-- Power menu stats panel labels, the same as the performance overlay's [CHAR LIMIT=5] -->
    <string name="global_actions_stats_cpu">CPU</string>
    <!-- Temperature of the chip [CHAR LIMIT=5] -->
    <string name="global_actions_stats_temp">TEMP</string>
    <!-- Battery [CHAR LIMIT=5] -->
    <string name="global_actions_stats_bat">BAT</string>
    <!-- Memory [CHAR LIMIT=5] -->
    <string name="global_actions_stats_ram">RAM</string>
    <!-- How busy the SD card is [CHAR LIMIT=5] -->
    <string name="global_actions_stats_storage">SD</string>
    <!-- How busy the built-in eMMC is, on an eMMC install [CHAR LIMIT=5] -->
    <string name="global_actions_stats_storage_emmc">eMMC</string>
    <!-- Small note under the RAM graph while compressed memory (zram swap) is on [CHAR LIMIT=12] -->
    <string name="global_actions_stats_zram">\u2713 ZRAM on</string>
    <!-- Legend under the RAM graph, one word per colored layer, all four on one short line:
         memory of the apps [CHAR LIMIT=6] -->
    <string name="global_actions_stats_ram_apps">apps</string>
    <!-- Legend: memory of the system kernel [CHAR LIMIT=6] -->
    <string name="global_actions_stats_ram_kernel">kernel</string>
    <!-- Legend: other used memory, e.g. graphics and drivers [CHAR LIMIT=6] -->
    <string name="global_actions_stats_ram_other">other</string>
    <!-- Legend: file cache, memory Android frees when it's needed [CHAR LIMIT=6] -->
    <string name="global_actions_stats_ram_cache">cache</string>
    <!-- Spoken description of the power menu stats panel [CHAR LIMIT=NONE] -->
    <string name="global_actions_stats_description">System stats of the last 10 minutes</string>
</resources>
