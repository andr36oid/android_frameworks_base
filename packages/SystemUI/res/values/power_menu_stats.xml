<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Power menu stats panel (GlobalActions console layout): four small graphs above the
         buttons. ro.andr36oid.power_menu_stats offers it, persist.sys.power_menu_stats=0 hides it. -->
    <dimen name="global_actions_stats_padding_horizontal">10dp</dimen>
    <dimen name="global_actions_stats_padding_vertical">5dp</dimen>
    <dimen name="global_actions_stats_cell_gap">10dp</dimen>
    <dimen name="global_actions_stats_graph_height">18dp</dimen>
    <dimen name="global_actions_stats_text_size">11sp</dimen>
    <!-- Space above and below the whole power menu while the panel shows, instead of
         global_actions_console_side_margin, so the buttons still fit a 480 px tall screen -->
    <dimen name="global_actions_stats_menu_padding">8dp</dimen>

    <!-- Power menu stats panel labels, the same as the performance overlay's [CHAR LIMIT=5] -->
    <string name="global_actions_stats_cpu">CPU</string>
    <!-- [CHAR LIMIT=5] -->
    <string name="global_actions_stats_gpu">GPU</string>
    <!-- Temperature of the chip [CHAR LIMIT=5] -->
    <string name="global_actions_stats_temp">TEMP</string>
    <!-- Battery [CHAR LIMIT=5] -->
    <string name="global_actions_stats_bat">BAT</string>
    <!-- Memory [CHAR LIMIT=5] -->
    <string name="global_actions_stats_ram">RAM</string>
    <!-- Below the temperature graph: the highest temperature it shows [CHAR LIMIT=12] -->
    <string name="global_actions_stats_temp_max">max <xliff:g id="temperature" example="61°C">%1$s</xliff:g></string>
    <!-- Spoken description of the power menu stats panel [CHAR LIMIT=NONE] -->
    <string name="global_actions_stats_description">System stats of the last 10 minutes</string>
</resources>
