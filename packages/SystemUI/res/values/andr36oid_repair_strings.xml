<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Heads-up notice while a card that wasn't unmounted cleanly is repaired before it mounts. %1$s is the card's name (its volume label, e.g. EASYROMS), %2$s its size (e.g. 477 GB). -->
    <string name="andr36oid_repair_title">Repairing %1$s (%2$s)…</string>
    <!-- Text of that notice: why it happens, that it slows the console down, and how to avoid it. -->
    <string name="andr36oid_repair_message">This card wasn\'t removed safely. Repairing it can take a few minutes, and the console is slower until it\'s done. Next time, shut down the console or eject the card before taking it out.</string>
</resources>
