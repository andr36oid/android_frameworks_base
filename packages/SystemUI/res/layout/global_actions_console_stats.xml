<!-- Power menu stats strip: a thin row along the top edge of the screen, above the power
     menu, with CPU, temperature, battery, SD card and RAM, each a line of text and a small
     graph under it. No card, only a dark fade. Nothing in it can take the D-pad focus. -->
<com.android.systemui.globalactions.PowerMenuStatsPanel
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/global_actions_stats"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/global_actions_stats_background"
    android:paddingHorizontal="@dimen/global_actions_stats_padding_horizontal"
    android:paddingTop="@dimen/global_actions_stats_padding_top"
    android:paddingBottom="@dimen/global_actions_stats_padding_bottom"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:focusable="false"
    android:focusableInTouchMode="false"
    android:descendantFocusability="blocksDescendants"
    android:contentDescription="@string/global_actions_stats_description"
    android:visibility="gone">

    <!-- CPU with the SD card's busy share under it, one column wide like the others -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:focusable="false">

        <include
            android:id="@+id/global_actions_stats_cpu"
            layout="@layout/global_actions_console_stats_cell"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <include
            android:id="@+id/global_actions_stats_storage"
            layout="@layout/global_actions_console_stats_cell"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/global_actions_stats_graph_gap" />
    </LinearLayout>

    <include
        android:id="@+id/global_actions_stats_temp"
        layout="@layout/global_actions_console_stats_cell"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/global_actions_stats_cell_gap" />

    <include
        android:id="@+id/global_actions_stats_bat"
        layout="@layout/global_actions_console_stats_cell"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/global_actions_stats_cell_gap" />

    <!-- RAM, with a legend for the graph's colors and a small "ZRAM on" note under it -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/global_actions_stats_cell_gap"
        android:orientation="vertical"
        android:focusable="false">

        <include
            android:id="@+id/global_actions_stats_ram"
            layout="@layout/global_actions_console_stats_cell"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/global_actions_stats_ram_legend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/global_actions_stats_graph_gap"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:ellipsize="none"
            android:shadowColor="#FF000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:textSize="@dimen/global_actions_stats_small_text_size" />

        <TextView
            android:id="@+id/global_actions_stats_zram"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/global_actions_stats_graph_gap"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:shadowColor="#FF000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:text="@string/global_actions_stats_zram"
            android:textColor="@color/global_actions_stats_good"
            android:textSize="@dimen/global_actions_stats_small_text_size"
            android:visibility="invisible" />
    </LinearLayout>

</com.android.systemui.globalactions.PowerMenuStatsPanel>
