<!-- Console power menu tile for an app: untinted app icon above the app name -->
<com.android.systemui.globalactions.GlobalActionsItem
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_weight="1"
    android:layout_height="@dimen/global_actions_console_item_height"
    android:layout_margin="@dimen/global_actions_console_item_margin"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/global_actions_console_item_padding"
    android:focusable="true"
    android:stateListAnimator="@anim/global_actions_console_item_animator"
    android:background="@drawable/global_actions_console_item_background">
    <ImageView
        android:id="@*android:id/icon"
        android:layout_width="@dimen/global_actions_console_app_icon_size"
        android:layout_height="@dimen/global_actions_console_app_icon_size"
        android:scaleType="centerInside" />
    <TextView
        android:id="@*android:id/message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/global_actions_console_app_label_margin"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="@dimen/global_actions_console_label_size"
        android:gravity="center"
        android:textColor="@color/control_primary_text"
        android:textAppearance="?android:attr/textAppearanceSmall" />
</com.android.systemui.globalactions.GlobalActionsItem>
