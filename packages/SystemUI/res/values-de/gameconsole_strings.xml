<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Button in the power menu that goes to the home screen [CHAR LIMIT=30] -->
    <string name="global_action_home">Startbildschirm</string>
    <!-- Button in the power menu that opens the recent apps, also the title of the power menu's own app switcher [CHAR LIMIT=30] -->
    <string name="global_action_app_switcher">App-Übersicht</string>
    <!-- Toast when opening the app switcher from the power menu with no other apps open [CHAR LIMIT=NONE] -->
    <string name="global_action_app_switcher_empty">Keine anderen Apps geöffnet</string>
    <!-- Button in the power menu that closes every app except the one on screen [CHAR LIMIT=30] -->
    <string name="global_action_close_apps">Hintergrund-Apps schließen</string>
    <!-- Toast after closing apps from the power menu [CHAR LIMIT=NONE] -->
    <plurals name="global_action_close_apps_done">
        <item quantity="one"><xliff:g id="count" example="1">%d</xliff:g> Hintergrund-App geschlossen</item>
        <item quantity="other"><xliff:g id="count" example="3">%d</xliff:g> Hintergrund-Apps geschlossen</item>
    </plurals>
    <!-- Toast after pressing close background apps in the power menu with nothing to close [CHAR LIMIT=NONE] -->
    <string name="global_action_close_apps_none">Keine Hintergrund-Apps zum Schließen</string>
    <!-- Small button at the bottom of the power menu that force stops the app on screen [CHAR LIMIT=NONE] -->
    <string name="global_action_kill_app">Aktive App beenden (<xliff:g id="app" example="RetroArch">%1$s</xliff:g>)</string>
    <!-- Toast after killing the app on screen from the power menu [CHAR LIMIT=NONE] -->
    <string name="global_action_kill_app_done"><xliff:g id="app" example="RetroArch">%1$s</xliff:g> beendet</string>
    <!-- Small print below the power menu's Settings button, holding it opens the menu customization [CHAR LIMIT=15] -->
    <string name="global_action_long_press_hint">Gedrückt halten</string>
</resources>
