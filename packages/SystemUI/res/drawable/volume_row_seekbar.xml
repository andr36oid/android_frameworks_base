<?xml version="1.0" encoding="utf-8"?>
<!-- andr36oid: a thick rounded track with a rounded fill, like the Android 16 volume panel.
     VolumeDialogImpl tints both: the fill in the accent, the track in a faint accent. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/volume_dialog_track_radius" />
            <solid android:color="@android:color/white" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <scale android:scaleWidth="100%">
            <shape android:shape="rectangle">
                <corners android:radius="@dimen/volume_dialog_track_radius" />
                <solid android:color="@android:color/white" />
            </shape>
        </scale>
    </item>
</layer-list>
